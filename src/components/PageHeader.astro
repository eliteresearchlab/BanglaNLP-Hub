---
import Plate from './Plate.astro';
interface Props { title: string; bn?: string; description?: string; plate?: boolean; }
const { title, bn, description, plate = false } = Astro.props;
---
<div class="band">
  <div class:list={plate && 'page-header-split'}>
    <header class="page-header graph">
      <slot name="breadcrumbs" />
      <h1 class="page-title">{title}{bn && !plate && ' '}{bn && !plate && <span class="bn" lang="bn">{bn}</span>}</h1>
      {description && <p class="page-description">{description}</p>}
      <slot />
    </header>
    {bn && plate && <Plate text={bn} />}
  </div>
</div>
