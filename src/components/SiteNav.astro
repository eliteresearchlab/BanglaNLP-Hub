---
import Search from './Search.astro';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
interface Props { active?: string; }
const { active = '' } = Astro.props;
const links = [
  ['tasks', 'Tasks'],
  ['datasets', 'Datasets'],
  ['papers', 'Papers'],
  ['tools', 'Tools'],
  ['contribute', 'Contribute'],
  ['about', 'About'],
];
---
<header class="site-header">
  <div class="navbar">
    <a class="brand" href={base + '/'} aria-label="BanglaNLP Hub home">
      <span class="brand-mark bn" lang="bn">ব</span>
      <span class="brand-name">BanglaNLP Hub</span>
    </a>
    <div class="nav-tools">
      <Search variant="nav" id="nav-search" />
      <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch to dark theme">
        <span class="theme-moon"><Icon name="moon" /></span><span class="theme-sun"><Icon name="sun" /></span>
      </button>
      <button id="nav-menu-toggle" class="icon-button navtoggle" type="button" aria-label="Menu" popovertarget="primary-nav">
        <span class="menu-open"><Icon name="menu" /></span><span class="menu-close"><Icon name="close" /></span>
      </button>
    </div>
    <nav id="primary-nav" class="navrow" aria-label="Primary" popover>
      {links.map(([id, label]) => <a class="navlink" href={base + '/' + id} aria-current={id === active ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>

<script>
  const themeButton = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const syncTheme = () => {
    const dark = root.classList.contains('dark');
    themeButton?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#181816' : '#f7f6f3');
  };
  syncTheme();
  themeButton?.addEventListener('click', () => {
    // Hold transitions back so every color changes in the same frame.
    root.classList.add('switching-theme');
    const dark = root.classList.toggle('dark');
    void document.body.offsetHeight;
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('switching-theme')));
    try { localStorage.bnlpTheme = dark ? 'dark' : 'light'; } catch {}
    syncTheme();
  });

  // The menu is a native popover, so it opens, closes and light-dismisses without
  // this script. The script only keeps keyboard opens instant and closes the
  // popover when the full navigation returns at a wider viewport.
  const menuButton = document.getElementById('nav-menu-toggle');
  const nav = document.getElementById('primary-nav');
  menuButton?.addEventListener('click', (event) => { if (nav) nav.dataset.motion = String(event.detail > 0); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && nav) nav.dataset.motion = 'false'; });
  matchMedia('(width >= 64rem)').addEventListener('change', (event) => {
    if (event.matches && nav && 'hidePopover' in nav && nav.matches(':popover-open')) nav.hidePopover();
  });
</script>
