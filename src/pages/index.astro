---
import Base from '../layouts/Base.astro';
import Search from '../components/Search.astro';
import Icon from '../components/Icon.astro';
import TaskCell from '../components/TaskCell.astro';
import { tasks, recentlyAdded, models, datasets, tools, stats, countLabel, communityContributors, codeContributors } from '../lib/data.ts';
import { hasBangla } from '../lib/text-patterns.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const allEntries = [...models, ...datasets, ...tools];
const contributors = communityContributors.map((c) => ({ ...c, entries: allEntries.filter((e) => String(e.link ?? '').includes(c.match)).length }));
const recent = recentlyAdded(6);
// The Bangla alphabet in order, down the left margin and then down the right.
const alphabet = [...'অআইঈউঊঋএঐওঔকখগঘঙচছজঝঞটঠডঢণতথদধনপফবভমযরলশষসহ', 'ড়', 'ঢ়', 'য়'];
---
<Base title="BanglaNLP Hub — Bangla NLP research in one place">
  <main class="page home">
    <div class="band">
      <section class="hero graph">
        <div class="letters letters-start bn" lang="bn" aria-hidden="true">{alphabet.slice(0, 23).map((letter) => <span>{letter}</span>)}</div>
        <div class="letters letters-end bn" lang="bn" aria-hidden="true">{alphabet.slice(23).map((letter) => <span class:list={letter === 'ব' && 'is-mark'}>{letter}</span>)}</div>
        <div class="hero-inner">
          <h1><span>{countLabel(stats.papers, 'paper')},</span>{' '}<span>{countLabel(stats.datasets, 'dataset')},</span>{' '}<span>{countLabel(stats.models, 'model')}.</span></h1>
          <p class="hero-description">One open catalog of Bangla language research, every entry linked to its source.</p>
          <p class="hero-bangla bn" lang="bn">বাংলা ভাষা, অসীম সম্ভাবনা।</p>
          <Search variant="hero" id="hero-search" />
          <p class="search-hint">Try <button class="example-query" type="button" data-query="BanglaBERT">BanglaBERT</button> or <button class="example-query" type="button" data-query="sentiment">sentiment</button></p>
        </div>
      </section>
    </div>

    <section class="section">
      <div class="band"><div class="bar">
        <h2 class="bar-title">Tasks</h2>
        <a class="button" href={base + '/tasks'}>View all {tasks.length}<Icon name="arrow-right" /></a>
      </div></div>
      <div class="cells">{tasks.slice(0, 8).map((task) => <TaskCell task={task} level="h3" />)}</div>
    </section>

    <section class="section">
      <div class="band"><div class="bar"><h2 class="bar-title">Recently verified</h2></div></div>
      <div class="rows">
        {recent.map((resource) => <a class="row" href={resource.href}>
          <span class="row-kind meta">{resource.type}</span>
          <span class="row-main"><span class:list={['row-name', hasBangla(resource.name) && 'bn']} lang={hasBangla(resource.name) ? 'bn' : undefined}>{resource.name}</span></span>
          <span class="meta">{resource.task}</span>
          <time datetime={resource.date}>{resource.date}</time>
        </a>)}
      </div>
    </section>

    <section class="section">
      <div class="band"><div class="bar">
        <h2 class="bar-title">Community</h2>
        <a class="button" href={base + '/contribute'}>Add a contribution<Icon name="arrow-right" /></a>
      </div></div>
      <div class="cells">
        {contributors.map((contributor) => <article class="cell">
          <h3 class="cell-name"><a class="card-link" href={contributor.link} target="_blank" rel="noopener">{contributor.name}</a></h3>
          <p>{contributor.blurb}</p>
          <p class="muted">{contributor.notable}</p>
          {contributor.entries > 0 && <p class="cell-foot">{contributor.entries} in the catalog</p>}
        </article>)}
      </div>
    </section>

    <section class="section">
      <div class="band"><div class="bar"><h2 class="bar-title">Built by</h2></div></div>
      <div class="cells">
        {codeContributors.map((contributor) => <article class="cell">
          <h3 class="cell-name"><a class="card-link" href={contributor.link} target="_blank" rel="noopener">{contributor.name}</a></h3>
          <p class="muted">@{contributor.handle}</p>
          <p>{contributor.blurb}</p>
          <p class="muted">{contributor.notable}</p>
        </article>)}
      </div>
    </section>
  </main>
</Base>
<script>
  const heroInput = document.getElementById('hero-search');
  document.querySelectorAll<HTMLButtonElement>('[data-query]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!(heroInput instanceof HTMLInputElement)) return;
      heroInput.value = button.dataset.query ?? '';
      heroInput.focus();
      heroInput.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });
</script>
