---
/** Tasks catalog. */
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import TaskCell from '../../components/TaskCell.astro';
import { tasks } from '../../lib/data.ts';
---

<Base title="Tasks — BanglaNLP Hub" active="tasks">
  <main class="page">
    <PageHeader
      title="Tasks"
      bn="কাজসমূহ"
      description="Every resource is filed under a task. Each task page collects its datasets, leaderboards, papers, and models."
    />
    <div class="cells">{tasks.map((task) => <TaskCell task={task} detailed />)}</div>
  </main>
</Base>
