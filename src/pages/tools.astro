---
/**
 * Tools — ported from design-reference/Tools.dc.html.
 *
 * One departure: the prototype rendered a "★ {stars}" count per card. Star
 * counts were dropped from the data during migration as illustrative and
 * instantly stale, so the element is omitted rather than shown empty.
 */
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import CopyIcon from '../components/CopyIcon.astro';
import { tools } from '../lib/data.ts';
---

<Base title="Tools & Libraries — BanglaNLP Hub" active="tools">
  <main class="page">
    <PageHeader
      title="Tools & Libraries"
      bn="সরঞ্জাম"
      description="Tokenizers, normalizers, embeddings, transliteration, and speech wrappers for working with Bangla text."
    />

    <section class="rows" aria-label="Tools and libraries">
      {tools.map((t) => (
        <article class="tool" id={t.id} tabindex="-1">
          <div class="tool-identity">
            <h2 class="cell-name"><a class="link-out" href={t.link} target="_blank" rel="noopener">{t.name}<Icon name="arrow-up-right" /></a></h2>
            <span class="meta">{t.author}, {t.lang}</span>
          </div>
          <div class="tool-summary">
            <p>{t.desc}</p>
            <span class="verified"><Icon name="check" />Verified <time datetime={t.verified}>{t.verified}</time></span>
          </div>
          <div class="tool-command">
            <pre><span class="muted" aria-hidden="true">$ </span>{t.install}</pre>
            <button class="button copy-button" type="button" data-install={t.install} aria-label={`Copy install command for ${t.name}`}><CopyIcon />Copy</button>
          </div>
          <p class="copy-status" aria-live="polite"></p>
        </article>
      ))}
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-button').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.install ?? '';
      const status = btn.closest('.tool')?.querySelector('.copy-status');
      let copied = false;
      try {
        await navigator.clipboard.writeText(text);
        copied = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.className = 'clipboard-fallback';
        document.body.appendChild(ta);
        ta.select();
        try {
          copied = document.execCommand('copy');
        } catch {}
        document.body.removeChild(ta);
        btn?.focus({ preventScroll: true });
      }
      if (copied) {
        btn.setAttribute('data-copied', '');
        setTimeout(() => btn.removeAttribute('data-copied'), 1600);
      }
      if (status) status.textContent = copied ? 'Command copied to clipboard.' : 'Copy failed. Select and copy the command.';
    });
  });
</script>
